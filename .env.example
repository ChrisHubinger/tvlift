# --- Tuya-Gerät (Werte aus `python -m tinytuya wizard`) ---
TUYA_DEVICE_ID=bfxxxxxxxxxxxxxxxxxxxx
TUYA_LOCAL_KEY=xxxxxxxxxxxxxxxx
TUYA_IP=192.168.1.50
# 3.3, 3.4 oder 3.5 – steht im Wizard/Scan-Output ("ver")
TUYA_VERSION=3.4

# --- HTTP-Service ---
LISTEN_ADDR=:8088
# Leer lassen = keine Authentifizierung (nicht empfohlen)
API_TOKEN=bitte-aendern

# --- Datenpunkte (Default = Tuya-TV-Lift-Kategorie "zndsj") ---
DP_MOVE=101
DP_MEMORY=103

# Einzelne Befehle überschreiben/ergänzen: CMD_<NAME>=<dp>=<wert>
# CMD_RECALL1=103=recall1
# CMD_UP=101=move_up

# Nur zum Ausprobieren von DPs: /api/set?dp=..&value=..
ALLOW_RAW=false
